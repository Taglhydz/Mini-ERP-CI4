###############################################################################
# Mini-ERP CI4 — .gitignore
###############################################################################

# Dépendances Composer
/vendor/

# Fichier d'environnement (contient les identifiants DB)
.env

# Logs CodeIgniter
/writable/logs/
/writable/cache/
/writable/session/
/writable/uploads/
/writable/debugbar/

# Fichiers de configuration locaux générés
app/Config/development/

# PHPUnit
.phpunit.result.cache
/build/

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
